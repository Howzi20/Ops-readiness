{
  "name": "ops-readiness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "update": "git checkout -- package-lock.json && git pull && npm install && prisma db push && tsx prisma/seed/maintain.ts",
    "go": "npm run update && npm run dev",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/seed.ts",
    "setup": "prisma db push && tsx prisma/seed/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^15.5.29",
    "nodemailer": "^6.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
