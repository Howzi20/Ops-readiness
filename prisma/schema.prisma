generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedTasks Task[]
}

// ---------- Operations Readiness: templates ----------

model Template {
  id          String               @id @default(cuid())
  name        String               @unique
  description String               @default("")
  createdAt   DateTime             @default(now())
  workstreams TemplateWorkstream[]
  sites       Site[]
}

model TemplateWorkstream {
  id         String         @id @default(cuid())
  templateId String
  template   Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  code       String // e.g. "1A"
  name       String
  sortOrder  Int
  tasks      TemplateTask[]
}

model TemplateTask {
  id            String             @id @default(cuid())
  workstreamId  String
  workstream    TemplateWorkstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  section       String             @default("")
  title         String
  priority      Int                @default(2)
  phase         String             @default("PRE_PC") // PRE_PC | POST_PC
  sortOrder     Int
}

// ---------- Operations Readiness: sites ----------

model Site {
  id              String       @id @default(cuid())
  name            String
  client          String       @default("")
  address         String       @default("")
  templateId      String?
  template        Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  transitionStart DateTime?
  pcDate          DateTime?
  goLiveDate      DateTime?
  createdAt       DateTime     @default(now())
  contacts        Contact[]
  workstreams     Workstream[]
  keyDates        KeyDate[]
  risks           Risk[]
}

model Contact {
  id           String       @id @default(cuid())
  siteId       String
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name         String
  organisation String       @default("TEAM") // TEAM | CLIENT | OTHER
  role         String       @default("")
  initials     String
  phone        String       @default("")
  email        String       @default("")
  leaveNotes   String       @default("")
  ownedStreams    Workstream[] @relation("WsOwner")
  approvedStreams Workstream[] @relation("WsApprover")
  ownedTasks      Task[]    @relation("Owner")
  signOffTasks    Task[]    @relation("SignOff")
  collaboratingOn Task[]    @relation("Collaborators")
}

model Workstream {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  code      String
  name      String
  sortOrder Int
  /// default person managing the workstream
  ownerId    String?
  owner      Contact? @relation("WsOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// default person approving the workstream's work
  approverId String?
  approver   Contact? @relation("WsApprover", fields: [approverId], references: [id], onDelete: SetNull)
  tasks     Task[]
}

model Task {
  id            String     @id @default(cuid())
  workstreamId  String
  workstream    Workstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  section       String     @default("")
  title         String
  sortOrder     Int
  priority      Int        @default(2)
  startDate     DateTime?
  targetDate    DateTime?
  status        String     @default("TO_COMMENCE") // TO_COMMENCE | IN_PROGRESS | DELAYED | COMPLETED | NA
  progress      Int        @default(0)
  phase         String     @default("PRE_PC")
  documented    String     @default("NO") // YES | NO | NA
  notes         String     @default("")
  flagOverride  String? // RED | YELLOW | GREEN
  overrideNote  String     @default("")
  /// manages the task
  ownerId       String?
  owner         Contact?   @relation("Owner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// approves the task before it can be Completed (optional)
  signOffId     String?
  signOff       Contact?   @relation("SignOff", fields: [signOffId], references: [id], onDelete: SetNull)
  signedOffAt   DateTime?
  signedOffBy   String     @default("")
  collaborators Contact[]  @relation("Collaborators")
  updatedById   String?
  updatedBy     User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt     DateTime   @updatedAt
  updates       TaskUpdate[]
}

/// A dated comment on a task ("updates" thread).
model TaskUpdate {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  createdAt  DateTime @default(now())
}

model KeyDate {
  id     String   @id @default(cuid())
  siteId String
  site   Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name   String
  date   DateTime
}

model Risk {
  id           String    @id @default(cuid())
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  number       Int
  function     String    @default("")
  description  String
  identifiedBy String    @default("")
  dateRecorded DateTime  @default(now())
  severity     String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  likelihood   String    @default("MEDIUM")
  responsible  String    @default("")
  targetDate   DateTime?
  action       String    @default("")
  status       String    @default("OPEN") // OPEN | CLOSED
}

/// Every email the app sends (or would send, when SMTP isn't configured).
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  text      String
  status    String // SENT | NOT_CONFIGURED | FAILED | NO_ADDRESS
  error     String   @default("")
  taskId    String?
  createdAt DateTime @default(now())
}
