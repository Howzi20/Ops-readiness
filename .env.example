DATABASE_URL="file:./dev.db"
# Prototype mode: leave as "false" to open the app without logging in.
# Set to "true" to require email/password logins (manage them on the Users page).
REQUIRE_LOGIN="false"
# any long random string; used to sign login sessions
SESSION_SECRET="change-me-to-a-long-random-string"

# Address people use to reach this app; used in email links.
APP_URL="http://localhost:3200"

# Email (optional). Leave SMTP_HOST empty to keep emails in the in-app Outbox instead of sending them.
# Examples - Microsoft 365: smtp.office365.com port 587 · Gmail: smtp.gmail.com port 587 with an App Password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""   # e.g. "Operations Readiness <you@example.com>"
